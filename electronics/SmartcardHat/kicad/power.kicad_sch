	(text "Efuse calculations\n\n       rising	falling\nvuvlo	1.24	1.13\nvovlo	1.24	1.13\n\nv-uv = vuvlo * (R33+R34+R35)/(R34+R35)\nv-ov = vovlo * (R33+R34+R34)/R35"
		(exclude_from_sim no)
		(at 191.008 47.752 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d461177c-8ede-4753-9a19-185375ba3666")
	)
	(text "R37 can be used instead of the voltage and current protection \nparts if you want to keep things cheap/simple\n(Basically everything not directly connected to the USB socket)"
		(exclude_from_sim no)
		(at 140.462 60.706 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e99b72dc-b083-43bd-80c2-e8f001145430")
	)
