		(uuid "42810a2d-524c-4bc5-9b8d-71e8633b3e75")
	)
	(text "Currently, the LCD Backlight PWM is not used at all in SeedSigner. \n\nWhile the waveshare hat pulls this input high, \nmeaning the hat will work without it connected, \nthe SeedSigner-Plus hat does not. \n(So it needs to be driven high here by default)"
		(exclude_from_sim no)
		(at 142.494 52.832 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "b4543be7-8892-4cba-a848-e2a73a94b639")
	)
	(text "Currently, SeedSigner doesn't have anything other than display on SPI.\n\nGiven this, you can generally just drive CS low all the time. \nThis works fine for the ST7789 display with SPI mode 3.\n(Though other displays may need it and Stock Seedsigner currently (Feb 2026)\nuses mode 0, which requires the CS pin) \n(Defaults to CS connected via GPIO)"
		(exclude_from_sim no)
		(at 227.33 23.876 0)
		(effects
			(font
				(size 1.27 1.27)
